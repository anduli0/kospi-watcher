# KOSPI-WATCHER environment template.
#
# Copy to `.env` and fill in. NEVER commit a real `.env` (it is git-ignored).
# Variable NAMES only here — no real secrets. pydantic-settings is
# case-insensitive and reads these from the process environment or `.env`.

# --- App ---
APP_ENV=development                 # development | staging | production
APP_NAME=KOSPI-WATCHER
APP_VERSION=0.1.0
SERVER_TIMEZONE=Asia/Seoul

# --- Persistence ---
# Local / CI (dockerless): SQLite via aiosqlite. Prod: Postgres via asyncpg.
DATABASE_URL=sqlite+aiosqlite:///./kospi_watcher.db
# DATABASE_URL=postgresql+asyncpg://kospi:CHANGE_ME@localhost:5432/kospi_watcher
# Empty -> in-memory fakeredis fallback (reported honestly at /health).
REDIS_URL=

# --- Trading safety (MANDATED DEFAULTS — do not enable without sign-off) ---
# Live execution is NOT implemented in this phase; these only gate configuration.
TRADING_MODE=RESEARCH               # RESEARCH | PAPER | GUARDED_LIVE | AUTO_LIVE
LIVE_TRADING_ENABLED=false
AUTO_EXECUTION_ENABLED=false

# --- Agents ---
# "mock" = deterministic offline; "llm" = real Anthropic agents (needs
# ANTHROPIC_API_KEY; falls back to mock on any error). Install the extra with
# `pip install -e ".[llm]"`. Override the model to a cheaper tier if desired.
AGENT_RUNTIME=mock                  # mock | llm
AGENT_MODEL=claude-opus-4-8         # or claude-sonnet-4-6 for high-volume runs
AGENT_MAX_TOKENS=2048

# --- Market data ---
MARKET_DATA_PROVIDER=yahoo          # yahoo (real, keyless) | mock
MARKET_DATA_TTL_SECONDS=60

# --- News scraping ---
NEWS_PROVIDER=google                # google (keyless RSS) | mock
NEWS_RETENTION_DAYS=14              # older items are pruned on each scrape

# --- BOK monetary policy (a core macro driver of the prediction, ADR-024) ---
# auto = classify hawkish/dovish from BOK news headlines; or set an authoritative
# stance to override the news read. Hawkish → KOSPI bearish (인버스/곱버스 우위).
MONETARY_POLICY_STANCE=auto         # auto | hawkish | neutral | dovish
MONETARY_POLICY_HIKES_2026=0        # net 25bp moves in 2026 (used when set manually; + = hikes)

# --- Telegram daily briefing (auto-sent at 08:00 Asia/Seoul by the worker) ---
# Create a bot via @BotFather for the token; message your bot then read your
# chat id from https://api.telegram.org/bot<token>/getUpdates. Both required to
# enable delivery — if unset, the briefing still runs but is not sent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MORNING_BRIEFING_HOUR=8
MORNING_BRIEFING_MINUTE=0

# --- Web / HTTP ---
# JSON array form because the field is a list (pydantic-settings parses JSON).
CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true

# --- Secrets (placeholders; left blank in Phase 0/1, never logged or returned) ---
ANTHROPIC_API_KEY=
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NUMBER=
KIWOOM_APP_KEY=
KIWOOM_APP_SECRET=
DART_API_KEY=
ECOS_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Frontend (apps/web) ---
# Base URL the Next.js app calls. Server-side default is http://localhost:8000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
