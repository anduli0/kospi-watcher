{
  "name": "kospi-watcher-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "KOSPI-WATCHER monorepo (npm workspaces). The Python backend is a single venv package; see pyproject.toml.",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "lint": "npm run lint --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test": "npm run test --workspace apps/web"
  },
  "engines": {
    "node": ">=20"
  }
}
