# Keep build contexts small and secrets out of images.
.git
.github
.venv
venv
**/__pycache__
*.pyc
*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache
*.db
*.sqlite3
.coverage
htmlcov

# Node / Next
**/node_modules
apps/web/.next
apps/web/out

# Secrets & local env (NEVER ship in an image)
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Docs / instructions not needed at runtime
docs
_KICKOFF.md
